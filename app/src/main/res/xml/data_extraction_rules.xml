<?xml version="1.0" encoding="utf-8"?>
<!-- The sync secret only opens with this watch's Keystore key, so it never goes into a backup or a transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync.xml" />
    </device-transfer>
</data-extraction-rules>
